{
  "model": "sonnet",
  "allowedTools": [
    "Read",
    "Write",
    "Edit",
    "Glob",
    "Grep",
    "Bash(npm:*)",
    "Bash(git:*)",
    "Bash(node:*)",
    "Bash(npx:*)"
  ],
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "npx prettier --write $TOOL_INPUT_FILE_PATH || true"
          }
        ]
      }
    ]
  }
}
