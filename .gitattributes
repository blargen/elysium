# Ensure consistent line endings across platforms
* text=auto

# Force LF line endings for source files
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.css text eol=lf
*.html text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Treat LevelDB pack files as binary to prevent corruption
packs/** binary

# Images and assets are binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.svg binary
*.ico binary

# Audio/Video
*.mp3 binary
*.mp4 binary
*.ogg binary
*.webm binary

# Fonts
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
